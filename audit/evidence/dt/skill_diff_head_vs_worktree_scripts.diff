diff --git a/skills/viet-ocr-eval/scripts/normalize.py b/skills/viet-ocr-eval/scripts/normalize.py
index fc229b2..901c475 100644
--- a/skills/viet-ocr-eval/scripts/normalize.py
+++ b/skills/viet-ocr-eval/scripts/normalize.py
@@ -176,6 +176,33 @@ def canonical(
     return text
 
 
+# --- Language screening -------------------------------------------------------
+
+# Marks that exist in Vietnamese orthography and in neither French nor English:
+# horn, breve, hook above, dot below — plus the letter d-with-stroke.
+_VI_ONLY_MARKS = {"\u031b", "\u0306", "\u0309", "\u0323"}
+
+
+def vi_marker_density(text: str) -> float:
+    """Vietnamese-only marks per 100 letters.
+
+    Vietnamese prose scores well above 1; French and English score 0 because
+    they never use these marks. Used by `verify` to find Latin-script pages
+    that are not Vietnamese, which a Latin-script ratio cannot detect.
+    """
+    letters = 0
+    marks = 0
+    for ch in unicodedata.normalize("NFD", text):
+        if ch in _VI_ONLY_MARKS:
+            marks += 1
+        elif ch in ("\u0111", "\u0110"):
+            marks += 1
+            letters += 1
+        elif ch.isalpha():
+            letters += 1
+    return 100.0 * marks / letters if letters else 0.0
+
+
